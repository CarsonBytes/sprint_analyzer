# Copy this file to .env and configure the backend you want to use.

# ─────────────────────────────────────────────────────────────────────────
# Backend selector. One of:
#   anthropic         → Claude API (default; recommended for demo / interviews)
#   openai            → any OpenAI-compatible endpoint (DeepSeek, GPT_API_free,
#                       OpenRouter, OpenAI proper, vLLM, etc.)
# ─────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic

# ── Anthropic (used when LLM_PROVIDER=anthropic) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model name uses the modern family-major-minor scheme adopted with Claude 4
# (e.g. claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4).
# Legacy dated names (e.g. claude-3-5-sonnet-20240620) still work but route
# to older snapshots — prefer the family name for best current-generation output.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_RETRIES=3

# ── OpenAI-compatible (used when LLM_PROVIDER=openai) ────────────────────
# For GPT_API_free (https://github.com/chatanywhere/GPT_API_free):
#   OPENAI_BASE_URL=https://api.chatanywhere.tech/v1
#   OPENAI_MODEL=deepseek-v3.2-exp
# For DeepSeek's own API:
#   OPENAI_BASE_URL=https://api.deepseek.com
#   OPENAI_MODEL=deepseek-chat
# For OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=deepseek/deepseek-chat
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.chatanywhere.tech/v1
# OPENAI_MODEL=deepseek-v3.2-exp
# OPENAI_MAX_RETRIES=3
